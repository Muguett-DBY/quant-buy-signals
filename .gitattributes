* text=auto

# Source, configuration and documentation use one canonical LF representation.
*.py text eol=lf
*.pyi text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.properties text eol=lf
gradlew text eol=lf
*.spec text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.csv text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
.gitkeep text eol=lf
LICENSE text eol=lf

# Windows launchers remain native for cmd.exe.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary artifacts must never be newline-normalised.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.jar binary
*.gz binary
*.7z binary
*.xls binary
*.xlsx binary
*.pkl binary
*.pickle binary
*.parquet binary
*.pyc binary
*.pyo binary
*.woff binary
*.woff2 binary
