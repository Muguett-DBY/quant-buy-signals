{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration/#supported-properties",
  "name": "ds-dcf-dispatch",
  "main": "worker.js",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": { "crons": ["15 8 * * MON-FRI"] }
}
