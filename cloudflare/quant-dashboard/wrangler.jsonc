{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/configuration/#supported-properties",
  "name": "quant-market-refresh",
  "main": "refresh_worker.js",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["45 8 * * 1-5"] },
  "d1_databases": [{ "binding": "DB", "database_name": "quant-market-data", "database_id": "REPLACE_WITH_D1_ID" }],
  "r2_buckets": [{ "binding": "DATA_BUCKET", "bucket_name": "quant-market-data" }],
  "vars": { "REFRESH_KEY": "SET_AS_A_SECRET" }
}
