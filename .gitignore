# Local audit/build scratch.  Keep the canonical random-100 artefacts in
# ``audit/`` trackable, but never let transient profiles, refresh captures or
# vendored scratch dependencies enter lint/package inputs.
tmp/
audit/profile-*/
audit/*.pstats
audit/refresh-*/

# Android builds are reproducible from the committed Gradle wrapper.  The SDK
# location and release-signing material are deliberately local-only.
android/.gradle/
android/local.properties
android/build/
android/app/build/
android/release.properties

# Playwright MCP artifacts (browser snapshots)
.playwright-mcp/

